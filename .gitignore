# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Data.  Everything under data/ is scraped or derived and is rebuilt by
#   openrapm ingest && openrapm stints
# The one exception is data/external/, the snapshot of public metrics used as a
# sanity check, which cannot be regenerated (it is a live spreadsheet).
/data/*
!/data/external/
/data/external/*
!/data/external/*.csv

# Run output.  Nothing here is an input to anything: every file is rebuilt by the
# command that wrote it.  The artifacts that DO ship live in artifacts/ and are tracked.
/outputs/

# Local research scratch, not part of the project.
/scratch/

# Node, only ever installed transiently to render-test the page.
node_modules/
package-lock.json
