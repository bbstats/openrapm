# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Data.  Everything under data/ is scraped or derived and is rebuilt by
#   openrapm data ingest && openrapm data stints   (and data/cache/ by the commands that read it)
# The one exception is data/external/, the snapshot of public metrics used as a
# sanity check, which cannot be regenerated (it is a live spreadsheet).
/data/*
!/data/external/
/data/external/*
!/data/external/*.csv

# Run output.  Every file is rebuilt by the command that wrote it, but some are inputs to later steps:
# the season panel (`openrapm data panel`), the saved boosters (`openrapm rate --save-models`), the
# within-season folds in outputs/within/ (`openrapm folds`) and the ratings tables each step reads.
# What ships is the site, docs/ (`openrapm site`), which is tracked.
/outputs/

# Local research scratch, not part of the project.
/scratch/

# Node, only ever installed transiently to render-test the page.
node_modules/
package-lock.json
